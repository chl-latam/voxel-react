{
  "name": "@procura/voxel-react",
  "version": "0.1.0",
  "description": "React components for visualizing Voxel packing results",
  "type": "module",
  "license": "MIT",
  "author": "CHL Group",
  "keywords": [
    "procura",
    "voxel",
    "react",
    "three.js",
    "3d",
    "bin-packing",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chl-latam/voxel-react.git"
  },
  "homepage": "https://github.com/chl-latam/voxel-react#readme",
  "bugs": {
    "url": "https://github.com/chl-latam/voxel-react/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external three --external @procura/voxel-core",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@procura/voxel-core": "^0.1.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "three": ">=0.170 <1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@procura/voxel-core": "file:../voxel-core",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
